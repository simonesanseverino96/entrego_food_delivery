# ─── App ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# ─── Database ────────────────────────────────────────────────────────────────
# Local: uses docker-compose postgres service
DATABASE_URL=postgresql://entrego:entrego_local@localhost:5432/entrego_dev

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── JWT (generate with: openssl rand -hex 32) ───────────────────────────────
JWT_SECRET=REPLACE_WITH_32+_CHAR_RANDOM_STRING
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# ─── Sentry (optional in dev) ────────────────────────────────────────────────
# SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# ─── Stripe 🧑 (open account first — task H1) ───────────────────────────────
STRIPE_SECRET_KEY=sk_test_REPLACE
STRIPE_WEBHOOK_SECRET=whsec_REPLACE

# ─── Twilio Verify 🧑 (task H3) ──────────────────────────────────────────────
TWILIO_ACCOUNT_SID=REPLACE
TWILIO_AUTH_TOKEN=REPLACE
TWILIO_VERIFY_SERVICE_SID=REPLACE

# ─── AWS / LocalStack ────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
AWS_S3_BUCKET_MEDIA=entrego-media-local
AWS_S3_BUCKET_DOCS=entrego-docs-local

# ─── LLM Translation 🧑 (task H9) ────────────────────────────────────────────
ANTHROPIC_API_KEY=REPLACE
# OPENAI_API_KEY=REPLACE   # fallback provider

# ─── Checkr 🧑 (task H2) ─────────────────────────────────────────────────────
# CHECKR_API_KEY=REPLACE

# ─── CORS ────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:3002,http://localhost:3003
