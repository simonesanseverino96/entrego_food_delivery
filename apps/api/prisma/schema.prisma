// Entrego — Prisma schema
// Money: integer cents always. Timestamps: timestamptz always.
// Geo columns are declared as Unsupported("geometry(...)") — Prisma limitation.
// PostGIS queries must use $queryRaw / $executeRaw.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis, citext]
}

// ── Enums ────────────────────────────────────────────────────────────────────

enum UserRole {
  customer
  courier
  restaurant_admin
  ops_admin
  super_admin
}

enum UserStatus {
  active
  suspended
  deleted
  pending
}

enum AuthProvider {
  password
  apple
  google
  phone
}

enum PreferredLanguage {
  en
  es
}

enum VehicleType {
  car
  scooter
  bike
  walk
}

enum BackgroundCheckStatus {
  not_started
  pending
  consider
  clear
  failed
}

enum W9Status {
  missing
  submitted
  verified
}

enum MinPayRule {
  none
  nyc
  ca_prop22
  seattle
}

enum OrderStatus {
  CREATED
  PAYMENT_AUTHORIZED
  SENT_TO_RESTAURANT
  ACCEPTED
  PREPARING
  READY_FOR_PICKUP
  COURIER_ASSIGNED
  COURIER_AT_RESTAURANT
  PICKED_UP
  EN_ROUTE
  ARRIVED
  DELIVERED
  COMPLETED
  REJECTED_BY_RESTAURANT
  CANCELLED_BY_CUSTOMER
  CANCELLED_BY_OPS
  UNDELIVERABLE
}

enum DropoffType {
  hand_to_me
  leave_at_door
}

enum ActorType {
  customer
  courier
  restaurant
  ops
  system
}

enum DispatchEventType {
  offered
  accepted
  declined
  timeout
  reassigned
}

enum CourierEarningType {
  base
  distance
  time
  tip
  incentive
  adjustment
  min_pay_topup
}

enum PayoutPeriodStatus {
  open
  processing
  paid
}

enum ChatSenderType {
  customer
  courier
  support
  system
}

enum MessageLang {
  en
  es
}

enum PromoType {
  pct
  fixed
  free_delivery
}

enum RefundStatus {
  requested
  auto_approved
  approved
  denied
}

enum RefundReason {
  missing_item
  wrong_item
  quality
  late
  never_arrived
  other
}

enum ConsentType {
  tos
  privacy
  background_check_fcra
  sms_tcpa
  location_bg
}

enum TaxDocumentType {
  w9
  form_1099_nec
  form_1099_k
}

enum SupportTicketStatus {
  open
  pending_customer
  pending_ops
  resolved
  closed
}

enum SupportTicketPriority {
  low
  normal
  high
  urgent
}

// ── Core models ──────────────────────────────────────────────────────────────

model User {
  id                String            @id @default(uuid()) @db.Uuid
  role              UserRole
  email             String?           @unique @db.Citext
  phone             String?           @unique
  passwordHash      String?           @map("password_hash")
  authProvider      AuthProvider      @map("auth_provider")
  firstName         String            @map("first_name")
  lastName          String            @map("last_name")
  preferredLanguage PreferredLanguage @default(en) @map("preferred_language")
  status            UserStatus        @default(pending)
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz
  deletedAt         DateTime?         @map("deleted_at") @db.Timestamptz

  customerProfile CustomerProfile?
  courierProfile  CourierProfile?
  addresses       Address[]
  auditLogs       AuditLog[]       @relation("AdminUser")

  @@map("users")
}

model CustomerProfile {
  userId          String  @id @map("user_id") @db.Uuid
  defaultAddressId String? @map("default_address_id") @db.Uuid
  stripeCustomerId String? @map("stripe_customer_id")
  marketingOptIn  Boolean @default(false) @map("marketing_opt_in")
  referralCode    String? @unique @map("referral_code")

  user User @relation(fields: [userId], references: [id])

  @@map("customer_profiles")
}

model Address {
  id                   String  @id @default(uuid()) @db.Uuid
  userId               String  @map("user_id") @db.Uuid
  label                String?
  line1                String
  line2                String?
  city                 String
  state                String  @db.Char(2)
  zip                  String
  // location geometry(Point,4326) — managed by raw SQL migration
  deliveryInstructions String? @map("delivery_instructions")
  isDefault            Boolean @default(false) @map("is_default")

  user User @relation(fields: [userId], references: [id])

  @@map("addresses")
}

model CourierProfile {
  userId                  String                @id @map("user_id") @db.Uuid
  stripeConnectAccountId  String?               @map("stripe_connect_account_id")
  vehicleType             VehicleType           @map("vehicle_type")
  driversLicenseVerified  Boolean               @default(false) @map("drivers_license_verified")
  identityVerifiedAt      DateTime?             @map("identity_verified_at") @db.Timestamptz
  backgroundCheckStatus   BackgroundCheckStatus @default(not_started) @map("background_check_status")
  checkrCandidateId       String?               @map("checkr_candidate_id")
  w9Status                W9Status              @default(missing) @map("w9_status")
  tinLast4                String?               @map("tin_last4")
  insuranceDocId          String?               @map("insurance_doc_id")
  homeState               String?               @map("home_state") @db.Char(2)
  activeCityId            String?               @map("active_city_id") @db.Uuid
  rating                  Decimal?              @db.Decimal(3, 2)
  completedDeliveries     Int                   @default(0) @map("completed_deliveries")
  acceptanceRate          Decimal?              @db.Decimal(5, 4) @map("acceptance_rate")
  isOnline                Boolean               @default(false) @map("is_online")
  maxConcurrent           Int                   @default(2) @map("max_concurrent")

  user   User  @relation(fields: [userId], references: [id])
  city   City? @relation(fields: [activeCityId], references: [id])

  shifts         CourierShift[]
  earnings       CourierEarning[]
  payoutPeriods  PayoutPeriod[]
  instantPayouts InstantPayout[]

  @@map("courier_profiles")
}

model City {
  id             String     @id @default(uuid()) @db.Uuid
  name           String
  state          String     @db.Char(2)
  timezone       String
  // service_area geometry(MultiPolygon,4326) — raw SQL
  isLive         Boolean    @default(false) @map("is_live")
  commissionCapPct Decimal? @map("commission_cap_pct") @db.Decimal(5, 4)
  minPayRule     MinPayRule @default(none) @map("min_pay_rule")
  surgeConfig    Json       @default("{}") @map("surge_config")

  restaurants    Restaurant[]
  couriers       CourierProfile[]
  orders         Order[]

  @@map("cities")
}

model Restaurant {
  id                  String   @id @default(uuid()) @db.Uuid
  cityId              String   @map("city_id") @db.Uuid
  ownerUserId         String   @map("owner_user_id") @db.Uuid
  legalName           String   @map("legal_name")
  displayName         String   @map("display_name")
  description         String?
  phone               String
  email               String
  addressLine1        String   @map("address_line1")
  addressLine2        String?  @map("address_line2")
  addressCity         String   @map("address_city")
  addressState        String   @map("address_state") @db.Char(2)
  addressZip          String   @map("address_zip")
  // location geometry(Point,4326) — raw SQL
  cuisineTags         String[] @map("cuisine_tags")
  priceLevel          Int      @default(2) @map("price_level")
  commissionPct       Decimal  @map("commission_pct") @db.Decimal(5, 4)
  stripeConnectAccountId String? @map("stripe_connect_account_id")
  w9Status            W9Status @default(missing) @map("w9_status")
  avgPrepMinutes      Int      @default(20) @map("avg_prep_minutes")
  rating              Decimal  @default(0) @db.Decimal(3, 2)
  ratingCount         Int      @default(0) @map("rating_count")
  isActive            Boolean  @default(false) @map("is_active")
  isAcceptingOrders   Boolean  @default(false) @map("is_accepting_orders")
  autoAccept          Boolean  @default(false) @map("auto_accept")
  hours               Json     @default("{}")
  holidayOverrides    Json     @default("{}") @map("holiday_overrides")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz

  city   City @relation(fields: [cityId], references: [id])
  menus  Menu[]
  orders Order[]

  @@map("restaurants")
}

model Menu {
  id           String         @id @default(uuid()) @db.Uuid
  restaurantId String         @map("restaurant_id") @db.Uuid
  name         String
  active       Boolean        @default(true)

  restaurant   Restaurant     @relation(fields: [restaurantId], references: [id])
  categories   MenuCategory[]

  @@map("menus")
}

model MenuCategory {
  id     String     @id @default(uuid()) @db.Uuid
  menuId String     @map("menu_id") @db.Uuid
  name   String
  sort   Int        @default(0)

  menu  Menu       @relation(fields: [menuId], references: [id])
  items MenuItem[]

  @@map("menu_categories")
}

model MenuItem {
  id           String   @id @default(uuid()) @db.Uuid
  categoryId   String   @map("category_id") @db.Uuid
  name         String
  description  String?
  priceCents   Int      @map("price_cents")
  imageUrl     String?  @map("image_url")
  isAvailable  Boolean  @default(true) @map("is_available")
  taxCode      String?  @map("tax_code")
  dietaryTags  String[] @map("dietary_tags")
  sort         Int      @default(0)

  category            MenuCategory       @relation(fields: [categoryId], references: [id])
  itemModifierGroups  ItemModifierGroup[]

  @@map("menu_items")
}

model ModifierGroup {
  id           String     @id @default(uuid()) @db.Uuid
  restaurantId String     @map("restaurant_id") @db.Uuid
  name         String
  minSelect    Int        @default(0) @map("min_select")
  maxSelect    Int        @default(1) @map("max_select")

  modifiers          Modifier[]
  itemModifierGroups ItemModifierGroup[]

  @@map("modifier_groups")
}

model Modifier {
  id          String  @id @default(uuid()) @db.Uuid
  groupId     String  @map("group_id") @db.Uuid
  name        String
  priceDeltaCents Int  @default(0) @map("price_delta_cents")
  isAvailable Boolean @default(true) @map("is_available")

  group ModifierGroup @relation(fields: [groupId], references: [id])

  @@map("modifiers")
}

model ItemModifierGroup {
  itemId  String @map("item_id") @db.Uuid
  groupId String @map("group_id") @db.Uuid
  sort    Int    @default(0)

  item  MenuItem      @relation(fields: [itemId], references: [id])
  group ModifierGroup @relation(fields: [groupId], references: [id])

  @@id([itemId, groupId])
  @@map("item_modifier_groups")
}

// ── Orders ───────────────────────────────────────────────────────────────────

model Order {
  id                    String      @id @default(uuid()) @db.Uuid
  publicCode            String      @unique @map("public_code")
  customerId            String      @map("customer_id") @db.Uuid
  restaurantId          String      @map("restaurant_id") @db.Uuid
  courierId             String?     @map("courier_id") @db.Uuid
  cityId                String      @map("city_id") @db.Uuid
  status                OrderStatus @default(CREATED)
  subtotalCents         Int         @map("subtotal_cents")
  deliveryFeeCents      Int         @map("delivery_fee_cents")
  serviceFeeCents       Int         @map("service_fee_cents")
  smallOrderFeeCents    Int         @default(0) @map("small_order_fee_cents")
  surgeCents            Int         @default(0) @map("surge_cents")
  tipCents              Int         @default(0) @map("tip_cents")
  taxCents              Int         @map("tax_cents")
  discountCents         Int         @default(0) @map("discount_cents")
  totalCents            Int         @map("total_cents")
  deliveryAddress       Json        @map("delivery_address")
  // delivery_location geometry(Point,4326) — raw SQL
  dropoffType           DropoffType @default(hand_to_me) @map("dropoff_type")
  scheduledFor          DateTime?   @map("scheduled_for") @db.Timestamptz
  stripePaymentIntentId String?     @map("stripe_payment_intent_id")
  taxCalculationId      String?     @map("tax_calculation_id")
  estimatedDeliveryAt   DateTime?   @map("estimated_delivery_at") @db.Timestamptz
  deliveredAt           DateTime?   @map("delivered_at") @db.Timestamptz
  proofPhotoUrl         String?     @map("proof_photo_url")
  cancellation          Json?
  createdAt             DateTime    @default(now()) @map("created_at") @db.Timestamptz

  restaurant Restaurant   @relation(fields: [restaurantId], references: [id])
  city       City         @relation(fields: [cityId], references: [id])
  items      OrderItem[]
  events     OrderEvent[]
  chatThread ChatThread?
  ratings    Rating[]
  refunds    Refund[]

  @@index([restaurantId, status])
  @@index([courierId, status])
  @@map("orders")
}

model OrderItem {
  id             String @id @default(uuid()) @db.Uuid
  orderId        String @map("order_id") @db.Uuid
  menuItemId     String @map("menu_item_id") @db.Uuid
  nameSnapshot   String @map("name_snapshot")
  qty            Int
  unitPriceCents Int    @map("unit_price_cents")
  modifiers      Json   @default("[]")
  note           String?

  order Order @relation(fields: [orderId], references: [id])

  @@map("order_items")
}

model OrderEvent {
  id         String      @id @default(uuid()) @db.Uuid
  orderId    String      @map("order_id") @db.Uuid
  fromStatus OrderStatus? @map("from_status")
  toStatus   OrderStatus @map("to_status")
  actorType  ActorType   @map("actor_type")
  actorId    String?     @map("actor_id") @db.Uuid
  metadata   Json        @default("{}")
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@map("order_events")
}

model DispatchEvent {
  id           String            @id @default(uuid()) @db.Uuid
  orderId      String            @map("order_id") @db.Uuid
  courierId    String            @map("courier_id") @db.Uuid
  type         DispatchEventType
  payOfferCents Int              @map("pay_offer_cents")
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz

  @@index([orderId])
  @@map("dispatch_events")
}

// ── Courier tracking ─────────────────────────────────────────────────────────

model CourierShift {
  id        String    @id @default(uuid()) @db.Uuid
  courierId String    @map("courier_id") @db.Uuid
  cityId    String    @map("city_id") @db.Uuid
  startedAt DateTime  @map("started_at") @db.Timestamptz
  endedAt   DateTime? @map("ended_at") @db.Timestamptz

  courier CourierProfile @relation(fields: [courierId], references: [userId])

  @@map("courier_shifts")
}

// courier_location_pings is partitioned by day — managed via raw SQL
// Prisma model is read-only; writes go through $executeRaw
model CourierLocationPing {
  courierId  String    @map("courier_id") @db.Uuid
  orderId    String?   @map("order_id") @db.Uuid
  // location geometry(Point,4326) — raw SQL
  recordedAt DateTime  @map("recorded_at") @db.Timestamptz

  @@id([courierId, recordedAt])
  @@map("courier_location_pings")
}

// ── Earnings & payouts ───────────────────────────────────────────────────────

model CourierEarning {
  id        String             @id @default(uuid()) @db.Uuid
  courierId String             @map("courier_id") @db.Uuid
  orderId   String?            @map("order_id") @db.Uuid
  type      CourierEarningType
  amountCents Int              @map("amount_cents")
  periodId  String?            @map("period_id") @db.Uuid
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz

  courier CourierProfile @relation(fields: [courierId], references: [userId])

  @@map("courier_earnings")
}

model PayoutPeriod {
  id              String            @id @default(uuid()) @db.Uuid
  courierId       String            @map("courier_id") @db.Uuid
  weekStart       DateTime          @map("week_start") @db.Date
  grossCents      Int               @default(0) @map("gross_cents")
  status          PayoutPeriodStatus @default(open)
  stripeTransferId String?          @map("stripe_transfer_id")

  courier CourierProfile @relation(fields: [courierId], references: [userId])

  @@map("payout_periods")
}

model InstantPayout {
  id             String   @id @default(uuid()) @db.Uuid
  courierId      String   @map("courier_id") @db.Uuid
  amountCents    Int      @map("amount_cents")
  feeCents       Int      @map("fee_cents")
  stripePayoutId String   @map("stripe_payout_id")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  courier CourierProfile @relation(fields: [courierId], references: [userId])

  @@map("instant_payouts")
}

// ── Chat ─────────────────────────────────────────────────────────────────────

model ChatThread {
  id      String @id @default(uuid()) @db.Uuid
  orderId String @unique @map("order_id") @db.Uuid

  order    Order         @relation(fields: [orderId], references: [id])
  messages ChatMessage[]

  @@map("chat_threads")
}

model ChatMessage {
  id              String         @id @default(uuid()) @db.Uuid
  threadId        String         @map("thread_id") @db.Uuid
  senderType      ChatSenderType @map("sender_type")
  senderId        String?        @map("sender_id") @db.Uuid
  originalText    String         @map("original_text")
  originalLang    MessageLang    @map("original_lang")
  translatedText  String?        @map("translated_text")
  translatedLang  MessageLang?   @map("translated_lang")
  translationMs   Int?           @map("translation_ms")
  deliveredAt     DateTime?      @map("delivered_at") @db.Timestamptz
  readAt          DateTime?      @map("read_at") @db.Timestamptz
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz

  thread ChatThread @relation(fields: [threadId], references: [id])

  @@index([threadId, createdAt])
  @@map("chat_messages")
}

// ── Promos ───────────────────────────────────────────────────────────────────

model Promo {
  id             String    @id @default(uuid()) @db.Uuid
  code           String    @unique
  type           PromoType
  value          Decimal   @db.Decimal(10, 4)
  minSubtotalCents Int?    @map("min_subtotal_cents")
  maxUses        Int?      @map("max_uses")
  perUserLimit   Int       @default(1) @map("per_user_limit")
  firstOrderOnly Boolean   @default(false) @map("first_order_only")
  cityIds        String[]  @map("city_ids") @db.Uuid
  startsAt       DateTime  @map("starts_at") @db.Timestamptz
  endsAt         DateTime  @map("ends_at") @db.Timestamptz
  budgetCents    Int?      @map("budget_cents")

  redemptions PromoRedemption[]

  @@map("promos")
}

model PromoRedemption {
  id          String   @id @default(uuid()) @db.Uuid
  promoId     String   @map("promo_id") @db.Uuid
  orderId     String   @map("order_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  amountCents Int      @map("amount_cents")

  promo Promo @relation(fields: [promoId], references: [id])

  @@unique([promoId, userId, orderId])
  @@map("promo_redemptions")
}

// ── Ratings & refunds ────────────────────────────────────────────────────────

model Rating {
  id              String  @id @default(uuid()) @db.Uuid
  orderId         String  @map("order_id") @db.Uuid
  restaurantStars Int?    @map("restaurant_stars")
  courierStars    Int?    @map("courier_stars")
  comment         String?
  flagged         Boolean @default(false)

  order Order @relation(fields: [orderId], references: [id])

  @@map("ratings")
}

model Refund {
  id              String       @id @default(uuid()) @db.Uuid
  orderId         String       @map("order_id") @db.Uuid
  requestedBy     String       @map("requested_by") @db.Uuid
  reason          RefundReason
  evidenceUrls    String[]     @map("evidence_urls")
  amountCents     Int          @map("amount_cents")
  status          RefundStatus @default(requested)
  resolverId      String?      @map("resolver_id") @db.Uuid
  stripeRefundId  String?      @map("stripe_refund_id")
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz

  order Order @relation(fields: [orderId], references: [id])

  @@map("refunds")
}

// ── Support ──────────────────────────────────────────────────────────────────

model SupportTicket {
  id         String                @id @default(uuid()) @db.Uuid
  userId     String                @map("user_id") @db.Uuid
  orderId    String?               @map("order_id") @db.Uuid
  channel    String
  subject    String
  status     SupportTicketStatus   @default(open)
  priority   SupportTicketPriority @default(normal)
  assigneeId String?               @map("assignee_id") @db.Uuid
  transcript Json                  @default("[]")
  createdAt  DateTime              @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime              @updatedAt @map("updated_at") @db.Timestamptz

  @@map("support_tickets")
}

// ── Compliance & audit ───────────────────────────────────────────────────────

model TaxDocument {
  id      String          @id @default(uuid()) @db.Uuid
  userId  String          @map("user_id") @db.Uuid
  year    Int
  type    TaxDocumentType
  fileUrl String          @map("file_url")
  status  String

  @@map("tax_documents")
}

model Consent {
  id        String      @id @default(uuid()) @db.Uuid
  userId    String      @map("user_id") @db.Uuid
  type      ConsentType
  version   String
  ip        String
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz

  @@map("consents")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  adminId   String   @map("admin_id") @db.Uuid
  action    String
  entity    String
  entityId  String   @map("entity_id")
  before    Json?
  after     Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  admin User @relation("AdminUser", fields: [adminId], references: [id])

  @@map("audit_logs")
}

model WebhookEvent {
  id          String    @id @default(uuid()) @db.Uuid
  provider    String
  eventId     String    @unique @map("event_id")
  payload     Json
  processedAt DateTime? @map("processed_at") @db.Timestamptz

  @@map("webhook_events")
}

model FeatureFlag {
  key    String  @id
  value  Json
  cityId String? @map("city_id") @db.Uuid

  @@map("feature_flags")
}
